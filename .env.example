# Copy to .env (docker compose loads it automatically) and fill in real values.
# .env is in .gitignore — never commit it.

# VPS public IP (clients connect to it)
VPS_IP=203.0.113.10

# Web admin password (51821) — wg-easy v14+ requires a bcrypt HASH, not the password.
# Generate:  docker run --rm ghcr.io/wg-easy/wg-easy:latest wgpw 'your-password'
# IMPORTANT: keep the single quotes — they stop docker compose from mangling the $ in the hash.
PASSWORD_HASH='$2b$12$generate-your-own-hash'

# Egyptian proxy (HTTP or SOCKS5)
PROXY_URL=http://user:pass@egypt_proxy:port

# Image version from the registry (bump in package.json before releasing)
VERSION=1.0.0
