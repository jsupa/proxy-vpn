# Skopíruj na .env (docker compose ho načíta automaticky) a doplň reálne hodnoty.
# .env je v .gitignore — nikdy necommitovať.

# Verejná IP VPS (klienti sa na ňu pripájajú)
VPS_IP=203.0.113.10

# Heslo do web adminu (51821) — wg-easy v14+ vyžaduje bcrypt HASH, nie heslo.
# Vygeneruješ:  docker run --rm ghcr.io/wg-easy/wg-easy:latest wgpw 'tvoje-heslo'
PASSWORD_HASH=$2b$12$vygeneruj-si-vlastny-hash

# SOCKS5 proxy v Egypte
PROXY_URL=socks5://uzivatel:heslo@ip_egypt_proxy:port

# Verzia obrazu z registry (bumpni v package.json pred releasom)
VERSION=1.0.0
